<%
const footerStore = typeof storeSettings !== 'undefined' && storeSettings ? storeSettings : {};
const footerStoreName = footerStore.name || 'S Fashion';
const footerLogoParts = footerStoreName.split(/\s+/).filter(Boolean);
const footerLogoFirst = footerLogoParts.shift() || 'S';
const footerLogoRest = footerLogoParts.join(' ') || 'Fashion';
const footerSocials = [
    { key: 'instagram', href: footerStore.socials?.instagram, label: 'Instagram', icon: 'ri-instagram-line' },
    { key: 'facebook', href: footerStore.socials?.facebook, label: 'Facebook', icon: 'ri-facebook-fill' },
    { key: 'tiktok', href: footerStore.socials?.tiktok, label: 'TikTok', icon: 'ri-tiktok-fill' },
].filter((social) => social.href);
%>

<footer class="footer">
    <div class="footer-main">
        <div class="footer-decoration footer-decoration-left"></div>
        <div class="footer-decoration footer-decoration-right"></div>

        <div class="footer-container">
            <div class="footer-brand">
                <a href="/" class="footer-logo">
                    <%= footerLogoFirst %> <span><%= footerLogoRest %></span>
                </a>

                <p class="footer-tagline">
                    <span>*</span>
                    Modern style for every moment, made to inspire.
                </p>

                <p class="footer-description">
                    Timeless designs, effortless comfort, and quality you can feel in every detail.
                </p>

                <% if (footerSocials.length > 0) { %>
                    <div class="footer-socials">
                        <% footerSocials.forEach((social) => { %>
                            <a href="<%= social.href %>" aria-label="<%= social.label %>" target="_blank" rel="noopener noreferrer">
                                <i class="<%= social.icon %>"></i>
                            </a>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <div class="footer-column">
                <h3>Shop</h3>
                <ul>
                    <li><a href="/shop?category=women">Women</a></li>
                    <li><a href="/shop?sort=latest">New In</a></li>
                    <li><a href="/shop?category=dresses">Dresses</a></li>
                    <li><a href="/shop?category=tops">Tops</a></li>
                    <li><a href="/shop?category=bottoms">Bottoms</a></li>
                    <li><a href="/shop?category=accessories">Accessories</a></li>
                    <li><a href="/shop?category=sale">Sale</a></li>
                    <li><a href="/shop">Lookbook</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Customer Service</h3>
                <ul>
                    <li><a href="/shop">Help Center</a></li>
                    <li><a href="/shop">Shipping & Delivery</a></li>
                    <li><a href="/shop">Returns & Exchanges</a></li>
                    <li><a href="/shop">Size Guide</a></li>
                    <li><a href="/profile">Track Order</a></li>
                    <li><a href="/shop">Gift Cards</a></li>
                    <li><a href="/shop">Store Locator</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>About Us</h3>
                <ul>
                    <li><a href="/shop">Our Story</a></li>
                    <li><a href="/shop">Sustainability</a></li>
                    <li><a href="/shop">Careers</a></li>
                    <li><a href="/shop">Press</a></li>
                    <li><a href="/shop">Terms & Conditions</a></li>
                    <li><a href="/shop">Privacy Policy</a></li>
                </ul>
            </div>

            <div class="footer-newsletter">
                <h3>Stay in the know</h3>

                <p>
                    Subscribe for new arrivals, exclusive offers, and style tips.
                </p>

                <form action="/shop" method="GET" class="newsletter-form">
                    <input type="email" name="email" placeholder="Enter your email address" />
                    <button type="submit">Explore</button>
                </form>

                <div class="newsletter-note">
                    <span>*</span>
                    <p>
                        Enjoy <strong>10% off</strong> your first order when you subscribe.
                    </p>
                </div>
            </div>

            <div class="footer-contact">
                <h3>Contact Us</h3>

                <% if (footerStore.phone) { %>
                    <div class="contact-item">
                        <div class="contact-icon">
                            <i class="ri-phone-line"></i>
                        </div>
                        <a href="tel:<%= footerStore.phone.replace(/[^0-9+]/g, '') %>"><%= footerStore.phone %></a>
                    </div>
                <% } %>

                <% if (footerStore.email) { %>
                    <div class="contact-item">
                        <div class="contact-icon">
                            <i class="ri-mail-line"></i>
                        </div>
                        <a href="mailto:<%= footerStore.email %>"><%= footerStore.email %></a>
                    </div>
                <% } %>

                <% if (footerStore.address) { %>
                    <div class="contact-item">
                        <div class="contact-icon">
                            <i class="ri-map-pin-line"></i>
                        </div>
                        <p><%= footerStore.address %></p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="footer-bottom-container">
            <p>&copy; <%= new Date().getFullYear() %> <%= footerStoreName %>. All rights reserved.</p>

            <div class="footer-bottom-links">
                <a href="/shop">Terms of Service</a>
                <span></span>
                <a href="/shop">Privacy Policy</a>
                <span></span>
                <a href="/shop">Cookies Settings</a>
                <span></span>
                <a href="/shop">Accessibility</a>
            </div>

            <div class="payment-methods">
                <span>VISA</span>
                <span>AMEX</span>
                <span>MC</span>
                <span>PayPal</span>
                <span>Pay</span>
            </div>
        </div>
    </div>
</footer>
