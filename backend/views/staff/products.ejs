<%
const titleCase = (value) => String(value || '-').replace(/_/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
const qsBase = new URLSearchParams();
if (filters.q) qsBase.set('q', filters.q);
if (filters.status) qsBase.set('status', filters.status);
%>

<%- include('partials/shell-start', {
  heading: 'Products',
  description: 'Read-only product catalog for staff operations.'
}) %>

<section class="staff-panel">
  <form method="GET" action="/staff/products" class="staff-filter-form">
    <label><span>Search</span><input type="search" name="q" value="<%= filters.q || '' %>" placeholder="Product name, SKU, slug" /></label>
    <label>
      <span>Status</span>
      <select name="status">
        <option value="">All Status</option>
        <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
        <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </label>
    <button type="submit" class="staff-btn secondary"><i class="ri-search-line"></i>Filter</button>
    <a href="/staff/products" class="staff-btn ghost">Reset</a>
  </form>

  <% if (!products || products.length === 0) { %>
    <article class="empty-state"><h2>No products found</h2><p class="muted">No products match your filter.</p></article>
  <% } else { %>
    <div class="staff-table-wrap">
      <table class="staff-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Category</th>
            <th>Variants</th>
            <th>Total Stock</th>
            <th>Status</th>
            <th>Storefront</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach((product) => { %>
            <tr>
              <td data-label="Product">
                <div class="product-cell">
                  <img src="<%= product.image_url || '/images/placeholder-product.jpg' %>" alt="<%= product.name %>" />
                  <div><strong><%= product.name %></strong><br><small><%= product.sku %></small></div>
                </div>
              </td>
              <td data-label="Category"><%= product.category_name || '-' %></td>
              <td data-label="Variants"><%= product.variant_count || 0 %></td>
              <td data-label="Total Stock"><%= product.total_stock || 0 %></td>
              <td data-label="Status"><span class="badge badge-<%= product.product_status %>"><%= titleCase(product.product_status) %></span></td>
              <td data-label="Storefront"><a href="/shop/<%= product.slug %>" target="_blank" class="staff-btn tiny ghost">View</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <nav class="pagination">
      <% for (let page = 1; page <= pagination.totalPages; page += 1) { const pageQs = new URLSearchParams(qsBase); pageQs.set('page', page); %>
        <a href="/staff/products?<%= pageQs.toString() %>" class="<%= page === pagination.page ? 'is-active' : '' %>"><%= page %></a>
      <% } %>
    </nav>
  <% } %>
</section>

<%- include('partials/shell-end') %>
