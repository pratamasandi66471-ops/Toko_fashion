<%
const titleCase = (value) => String(value || '-').replace(/_/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
const stockState = (value) => {
  const stockValue = Number(value || 0);
  if (stockValue <= 0) return { label: 'Out', className: 'out' };
  if (stockValue <= lowStockThreshold) return { label: 'Low', className: 'low' };
  return { label: 'Available', className: 'available' };
};
const qsBase = new URLSearchParams();
if (filters.q) qsBase.set('q', filters.q);
if (filters.stock) qsBase.set('stock', filters.stock);
if (filters.status) qsBase.set('status', filters.status);
%>

<%- include('partials/shell-start', {
  heading: 'Stocks',
  description: 'Monitor and update product variant stock.'
}) %>

<section class="staff-panel">
  <form method="GET" action="/staff/stocks" class="staff-filter-form">
    <label><span>Search</span><input type="search" name="q" value="<%= filters.q || '' %>" placeholder="Product name, SKU, variant SKU" /></label>
    <label>
      <span>Stock</span>
      <select name="stock">
        <option value="">All Stock</option>
        <option value="available" <%= filters.stock === 'available' ? 'selected' : '' %>>Available</option>
        <option value="low" <%= filters.stock === 'low' ? 'selected' : '' %>>Low</option>
        <option value="out" <%= filters.stock === 'out' ? 'selected' : '' %>>Out</option>
      </select>
    </label>
    <label>
      <span>Status</span>
      <select name="status">
        <option value="">All Status</option>
        <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </label>
    <button type="submit" class="staff-btn secondary"><i class="ri-search-line"></i>Filter</button>
    <a href="/staff/stocks" class="staff-btn ghost">Reset</a>
  </form>

  <% if (!stocks || stocks.length === 0) { %>
    <article class="empty-state"><h2>No stock data</h2><p class="muted">No variants match your filter.</p></article>
  <% } else { %>
    <div class="staff-table-wrap">
      <table class="staff-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Variant</th>
            <th>Size</th>
            <th>Color</th>
            <th>Stock</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% stocks.forEach((item) => { const state = stockState(item.stock); %>
            <tr>
              <td data-label="Product">
                <div class="stock-cell">
                  <img src="<%= item.image_url || '/images/placeholder-product.jpg' %>" alt="<%= item.product_name %>" />
                  <div><strong><%= item.product_name %></strong><br><small><%= item.product_sku %></small></div>
                </div>
              </td>
              <td data-label="Variant"><%= item.variant_sku || '-' %></td>
              <td data-label="Size"><%= item.size || '-' %></td>
              <td data-label="Color"><%= item.color || '-' %></td>
              <td data-label="Stock"><strong><%= item.stock %></strong> <span class="badge badge-<%= state.className %>"><%= state.label %></span></td>
              <td data-label="Status"><span class="badge badge-<%= item.variant_status %>"><%= titleCase(item.variant_status) %></span></td>
              <td data-label="Action">
                <form method="POST" action="/staff/stocks/<%= item.id %>/update" class="stock-form">
                  <input type="number" name="stock" value="<%= item.stock %>" min="0" step="1" required />
                  <button type="submit" class="staff-btn tiny primary">Save</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <nav class="pagination">
      <% for (let page = 1; page <= pagination.totalPages; page += 1) { const pageQs = new URLSearchParams(qsBase); pageQs.set('page', page); %>
        <a href="/staff/stocks?<%= pageQs.toString() %>" class="<%= page === pagination.page ? 'is-active' : '' %>"><%= page %></a>
      <% } %>
    </nav>
  <% } %>
</section>

<%- include('partials/shell-end') %>
