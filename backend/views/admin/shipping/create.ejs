<%- include('../partials/shell-start', {
  heading: 'Create Shipping',
  description: 'Add a checkout shipping method.'
}) %>

<section class="shipping-page">
  <section class="crud-panel form-panel">
    <form method="POST" action="/admin/shipping" class="crud-form">
      <%- include('form', { old, formErrors }) %>
      <div class="form-actions">
        <a href="/admin/shipping" class="crud-btn ghost">Cancel</a>
        <button type="submit" class="crud-btn primary"><i class="ri-save-3-line"></i>Create Shipping</button>
      </div>
    </form>
  </section>
</section>

<%- include('../partials/shell-end') %>
