<%
const titleCase = (value) => String(value || '-').replace(/_/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
const isPinned = old.is_pinned === 1 || old.is_pinned === true || old.is_pinned === 'on';
%>

<div class="form-grid">
  <label class="full-span">
    <span>Title</span>
    <input type="text" name="title" value="<%= old.title || '' %>" maxlength="150" placeholder="Notification title" required />
    <% if (formErrors.title) { %><small class="field-error"><%= formErrors.title %></small><% } %>
  </label>

  <label>
    <span>Type</span>
    <select name="type">
      <% typeOptions.forEach((type) => { %>
        <option value="<%= type %>" <%= old.type === type ? 'selected' : '' %>><%= titleCase(type) %></option>
      <% }); %>
    </select>
    <% if (formErrors.type) { %><small class="field-error"><%= formErrors.type %></small><% } %>
  </label>

  <label>
    <span>Audience</span>
    <select name="audience">
      <% audienceOptions.forEach((audience) => { %>
        <option value="<%= audience %>" <%= old.audience === audience ? 'selected' : '' %>><%= titleCase(audience) %></option>
      <% }); %>
    </select>
    <% if (formErrors.audience) { %><small class="field-error"><%= formErrors.audience %></small><% } %>
  </label>

  <label>
    <span>Status</span>
    <select name="status">
      <% statusOptions.forEach((status) => { %>
        <option value="<%= status %>" <%= old.status === status ? 'selected' : '' %>><%= titleCase(status) %></option>
      <% }); %>
    </select>
    <% if (formErrors.status) { %><small class="field-error"><%= formErrors.status %></small><% } %>
  </label>

  <label class="notification-check">
    <input type="checkbox" name="is_pinned" <%= isPinned ? 'checked' : '' %> />
    <span>Pin notification</span>
  </label>

  <label class="full-span">
    <span>Message</span>
    <textarea name="message" rows="6" maxlength="2000" placeholder="Notification message" required><%= old.message || '' %></textarea>
    <% if (formErrors.message) { %><small class="field-error"><%= formErrors.message %></small><% } %>
  </label>

  <label>
    <span>Action Label</span>
    <input type="text" name="action_label" value="<%= old.action_label || '' %>" maxlength="80" placeholder="Open" />
    <% if (formErrors.action_label) { %><small class="field-error"><%= formErrors.action_label %></small><% } %>
  </label>

  <label>
    <span>Action URL</span>
    <input type="text" name="action_url" value="<%= old.action_url || '' %>" placeholder="/admin/orders or https://..." />
    <% if (formErrors.action_url) { %><small class="field-error"><%= formErrors.action_url %></small><% } %>
  </label>
</div>
