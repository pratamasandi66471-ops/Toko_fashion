<%
const formatDate = (value) => value ? new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value)) : '-';
const titleCase = (value) => String(value || '-').replace(/_/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
const qsBase = new URLSearchParams();
if (filters.q) qsBase.set('q', filters.q);
if (filters.status) qsBase.set('status', filters.status);
if (filters.type && !context.fixedType) qsBase.set('type', filters.type);
if (filters.placement) qsBase.set('placement', filters.placement);
%>

<%- include('../partials/shell-start', {
  heading: context.heading,
  description: context.description
}) %>

<section class="marketing-content-page">
  <section class="crud-panel marketing-content-panel">
    <div class="crud-actions-row">
      <form method="GET" action="<%= context.basePath %>" class="crud-filter-form marketing-content-filter-form">
        <label>
          <span>Search</span>
          <input type="search" name="q" value="<%= filters.q || '' %>" placeholder="Title, subtitle, body" />
        </label>
        <% if (!context.fixedType) { %>
          <label>
            <span>Type</span>
            <select name="type">
              <option value="">All Types</option>
              <% typeOptions.forEach((type) => { %>
                <option value="<%= type %>" <%= filters.type === type ? 'selected' : '' %>><%= titleCase(type) %></option>
              <% }); %>
            </select>
          </label>
        <% } %>
        <label>
          <span>Status</span>
          <select name="status">
            <option value="">All Status</option>
            <% statusOptions.forEach((status) => { %>
              <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= titleCase(status) %></option>
            <% }); %>
          </select>
        </label>
        <label>
          <span>Placement</span>
          <select name="placement">
            <option value="">All Placement</option>
            <% placementOptions.forEach((placement) => { %>
              <option value="<%= placement %>" <%= filters.placement === placement ? 'selected' : '' %>><%= titleCase(placement) %></option>
            <% }); %>
          </select>
        </label>
        <button type="submit" class="crud-btn secondary"><i class="ri-search-line"></i>Filter</button>
        <a href="<%= context.basePath %>" class="crud-btn ghost">Reset</a>
      </form>
      <a href="<%= context.basePath %>/create" class="crud-btn primary"><i class="ri-megaphone-line"></i>Add</a>
    </div>

    <% if (!contents || contents.length === 0) { %>
      <article class="crud-empty">
        <i class="ri-megaphone-line"></i>
        <h2>Belum ada content</h2>
        <p>Buat campaign, banner, atau announcement pertama untuk S Fashion.</p>
        <a href="<%= context.basePath %>/create" class="crud-btn primary">Create</a>
      </article>
    <% } else { %>
      <div class="crud-table-wrap">
        <table class="crud-table marketing-content-table">
          <thead>
            <tr>
              <th>Content</th>
              <th>Type</th>
              <th>Placement</th>
              <th>Schedule</th>
              <th>Status</th>
              <th>Sort</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% contents.forEach((item) => { %>
              <tr>
                <td data-label="Content">
                  <strong><%= item.title %></strong>
                  <small><%= item.subtitle || item.body || '-' %></small>
                  <% if (item.cta_url) { %><small>CTA: <%= item.cta_label || item.cta_url %></small><% } %>
                </td>
                <td data-label="Type"><span class="marketing-badge type-<%= item.content_type %>"><%= titleCase(item.content_type) %></span></td>
                <td data-label="Placement"><%= titleCase(item.placement) %></td>
                <td data-label="Schedule">
                  <strong><%= formatDate(item.starts_at) %></strong>
                  <small>to <%= formatDate(item.ends_at) %></small>
                </td>
                <td data-label="Status"><span class="marketing-badge status-<%= item.status %>"><%= titleCase(item.status) %></span></td>
                <td data-label="Sort"><%= item.sort_order %></td>
                <td data-label="Actions">
                  <div class="table-actions">
                    <a href="<%= context.basePath %>/<%= item.id %>/edit" class="crud-btn tiny primary">Edit</a>
                    <form method="POST" action="<%= context.basePath %>/<%= item.id %>/toggle-status">
                      <button type="submit" class="crud-btn tiny ghost"><%= item.status === 'active' ? 'Deactivate' : 'Activate' %></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <nav class="crud-pagination">
        <% for (let page = 1; page <= pagination.totalPages; page += 1) { const pageQs = new URLSearchParams(qsBase); pageQs.set('page', page); %>
          <a href="<%= context.basePath %>?<%= pageQs.toString() %>" class="<%= page === pagination.page ? 'is-active' : '' %>"><%= page %></a>
        <% } %>
      </nav>
    <% } %>
  </section>
</section>

<%- include('../partials/shell-end') %>
