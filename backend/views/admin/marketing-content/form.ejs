<%
const titleCase = (value) => String(value || '-').replace(/_/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
%>

<div class="form-grid">
  <% if (!context.fixedType) { %>
    <label>
      <span>Content Type</span>
      <select name="content_type">
        <% typeOptions.forEach((type) => { %>
          <option value="<%= type %>" <%= old.content_type === type ? 'selected' : '' %>><%= titleCase(type) %></option>
        <% }); %>
      </select>
      <% if (formErrors.content_type) { %><small class="field-error"><%= formErrors.content_type %></small><% } %>
    </label>
  <% } %>

  <label class="<%= context.fixedType ? 'full-span' : '' %>">
    <span>Title</span>
    <input type="text" name="title" value="<%= old.title || '' %>" maxlength="150" placeholder="Campaign title" required />
    <% if (formErrors.title) { %><small class="field-error"><%= formErrors.title %></small><% } %>
  </label>

  <label>
    <span>Placement</span>
    <select name="placement">
      <% placementOptions.forEach((placement) => { %>
        <option value="<%= placement %>" <%= old.placement === placement ? 'selected' : '' %>><%= titleCase(placement) %></option>
      <% }); %>
    </select>
    <% if (formErrors.placement) { %><small class="field-error"><%= formErrors.placement %></small><% } %>
  </label>

  <label>
    <span>Status</span>
    <select name="status">
      <% statusOptions.forEach((status) => { %>
        <option value="<%= status %>" <%= old.status === status ? 'selected' : '' %>><%= titleCase(status) %></option>
      <% }); %>
    </select>
    <% if (formErrors.status) { %><small class="field-error"><%= formErrors.status %></small><% } %>
  </label>

  <label>
    <span>Sort Order</span>
    <input type="number" name="sort_order" value="<%= old.sort_order ?? 0 %>" step="1" />
    <% if (formErrors.sort_order) { %><small class="field-error"><%= formErrors.sort_order %></small><% } %>
  </label>

  <label class="full-span">
    <span>Subtitle</span>
    <input type="text" name="subtitle" value="<%= old.subtitle || '' %>" maxlength="255" placeholder="Short campaign subtitle" />
    <% if (formErrors.subtitle) { %><small class="field-error"><%= formErrors.subtitle %></small><% } %>
  </label>

  <label class="full-span">
    <span>Body</span>
    <textarea name="body" rows="5" maxlength="2000" placeholder="Campaign message or content copy"><%= old.body || '' %></textarea>
    <% if (formErrors.body) { %><small class="field-error"><%= formErrors.body %></small><% } %>
  </label>

  <label class="full-span">
    <span>Image URL</span>
    <input type="url" name="image_url" value="<%= old.image_url || '' %>" placeholder="https://example.com/banner.jpg" />
    <% if (formErrors.image_url) { %><small class="field-error"><%= formErrors.image_url %></small><% } %>
  </label>

  <label>
    <span>CTA Label</span>
    <input type="text" name="cta_label" value="<%= old.cta_label || '' %>" maxlength="80" placeholder="Shop Now" />
    <% if (formErrors.cta_label) { %><small class="field-error"><%= formErrors.cta_label %></small><% } %>
  </label>

  <label>
    <span>CTA URL</span>
    <input type="url" name="cta_url" value="<%= old.cta_url || '' %>" placeholder="https://sfashion.test/shop" />
    <% if (formErrors.cta_url) { %><small class="field-error"><%= formErrors.cta_url %></small><% } %>
  </label>

  <label>
    <span>Start At</span>
    <input type="datetime-local" name="starts_at" value="<%= old.starts_at || '' %>" />
    <% if (formErrors.starts_at) { %><small class="field-error"><%= formErrors.starts_at %></small><% } %>
  </label>

  <label>
    <span>End At</span>
    <input type="datetime-local" name="ends_at" value="<%= old.ends_at || '' %>" />
    <% if (formErrors.ends_at) { %><small class="field-error"><%= formErrors.ends_at %></small><% } %>
  </label>
</div>
