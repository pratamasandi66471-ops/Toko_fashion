<%- include('../partials/shell-start', {
  heading: 'Audit Logs',
  description: 'Track admin and staff activities across S Fashion.'
}) %>

<%
function shortText(value, max = 90) {
  const text = String(value || '-');
  return text.length > max ? `${text.slice(0, max)}...` : text;
}

function formatDate(value) {
  if (!value) return '-';
  return new Intl.DateTimeFormat('id-ID', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'Asia/Jakarta',
  }).format(new Date(value));
}

function prettyValue(value) {
  if (!value) return '-';
  try {
    return JSON.stringify(JSON.parse(value), null, 2);
  } catch (_error) {
    return value;
  }
}

const baseQs = new URLSearchParams();
if (filters.q) baseQs.set('q', filters.q);
if (filters.action) baseQs.set('action', filters.action);
if (filters.entityType) baseQs.set('entityType', filters.entityType);
if (filters.userId) baseQs.set('userId', filters.userId);
%>

<section class="audit-page">
  <section class="crud-panel audit-filter-panel">
    <form method="GET" action="/admin/audit-logs" class="crud-filter-form audit-filter-form">
      <label>
        <span>Search</span>
        <input type="search" name="q" value="<%= filters.q || '' %>" placeholder="Action, entity, role, user" />
      </label>
      <label>
        <span>Action</span>
        <select name="action">
          <option value="">All Actions</option>
          <% actions.forEach((item) => { %>
            <option value="<%= item.action %>" <%= filters.action === item.action ? 'selected' : '' %>><%= item.action %></option>
          <% }) %>
        </select>
      </label>
      <label>
        <span>Entity Type</span>
        <select name="entityType">
          <option value="">All Entities</option>
          <% entityTypes.forEach((item) => { %>
            <option value="<%= item.entity_type %>" <%= filters.entityType === item.entity_type ? 'selected' : '' %>><%= item.entity_type %></option>
          <% }) %>
        </select>
      </label>
      <label>
        <span>User ID</span>
        <input type="number" name="userId" min="1" value="<%= filters.userId || '' %>" placeholder="Optional" />
      </label>
      <button type="submit" class="crud-btn primary">Filter</button>
      <a href="/admin/audit-logs" class="crud-btn ghost">Reset</a>
    </form>
  </section>

  <section class="crud-panel audit-panel">
    <% if (!logs || logs.length === 0) { %>
      <div class="crud-empty-state">
        <i class="ri-file-search-line"></i>
        <h3>No audit logs found</h3>
        <p>Important admin and staff actions will appear here after the migration is installed.</p>
      </div>
    <% } else { %>
      <div class="crud-table-wrap">
        <table class="crud-table audit-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>User</th>
              <th>Role</th>
              <th>Action</th>
              <th>Entity</th>
              <th>IP Address</th>
              <th>User Agent</th>
              <th>Old / New</th>
            </tr>
          </thead>
          <tbody>
            <% logs.forEach((log) => { %>
              <tr>
                <td data-label="Date"><strong><%= formatDate(log.created_at) %></strong></td>
                <td data-label="User">
                  <strong><%= log.user_name || 'Unknown User' %></strong>
                  <small>#<%= log.user_id || '-' %> <%= log.user_email ? `- ${log.user_email}` : '' %></small>
                </td>
                <td data-label="Role"><span class="audit-badge role-badge"><%= log.role || '-' %></span></td>
                <td data-label="Action"><span class="audit-badge action-badge"><%= log.action %></span></td>
                <td data-label="Entity">
                  <span class="audit-badge entity-badge"><%= log.entity_type %></span>
                  <small>#<%= log.entity_id || '-' %></small>
                </td>
                <td data-label="IP Address"><code><%= log.ip_address || '-' %></code></td>
                <td data-label="User Agent"><span title="<%= log.user_agent || '' %>"><%= shortText(log.user_agent, 42) %></span></td>
                <td data-label="Old / New">
                  <details class="audit-values">
                    <summary>Preview</summary>
                    <div>
                      <strong>Old</strong>
                      <pre><%= prettyValue(log.old_values) %></pre>
                      <strong>New</strong>
                      <pre><%= prettyValue(log.new_values) %></pre>
                    </div>
                  </details>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (pagination.totalPages > 1) { %>
      <nav class="crud-pagination">
        <% for (let page = 1; page <= pagination.totalPages; page += 1) {
          const pageQs = new URLSearchParams(baseQs);
          pageQs.set('page', page);
        %>
          <a href="/admin/audit-logs?<%= pageQs.toString() %>" class="<%= page === pagination.page ? 'is-active' : '' %>"><%= page %></a>
        <% } %>
      </nav>
    <% } %>
  </section>
</section>

<%- include('../partials/shell-end') %>
