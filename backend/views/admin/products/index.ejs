<%
const formatRupiah = (value) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(Number(value || 0));
const qsBase = new URLSearchParams();
if (filters.search) qsBase.set('search', filters.search);
if (filters.categoryId) qsBase.set('category_id', filters.categoryId);
if (filters.status) qsBase.set('status', filters.status);
if (filters.lowStock) qsBase.set('low_stock', '1');
%>

<%- include('../partials/shell-start', {
  heading: 'Product Management',
  description: 'Kelola produk, harga, stok variant, dan gambar storefront.'
}) %>

<section class="crud-panel">
  <div class="crud-actions-row">
    <form method="GET" action="/admin/products" class="crud-filter-form product-filter-form">
      <label>
        <span>Search</span>
        <input type="search" name="search" value="<%= filters.search || '' %>" placeholder="Name, SKU, slug" />
      </label>
      <label>
        <span>Category</span>
        <select name="category_id">
          <option value="">All Categories</option>
          <% categories.forEach((category) => { %>
            <option value="<%= category.id %>" <%= Number(filters.categoryId) === Number(category.id) ? 'selected' : '' %>><%= category.name %></option>
          <% }); %>
        </select>
      </label>
      <label>
        <span>Status</span>
        <select name="status">
          <option value="">All Status</option>
          <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
          <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
      </label>
      <label class="check-filter">
        <input type="checkbox" name="low_stock" value="1" <%= filters.lowStock ? 'checked' : '' %> />
        <span>Low stock only</span>
      </label>
      <button type="submit" class="crud-btn secondary"><i class="ri-search-line"></i>Filter</button>
      <a href="/admin/products" class="crud-btn ghost">Reset</a>
    </form>
    <a href="/admin/products/create" class="crud-btn primary"><i class="ri-add-line"></i>Create Product</a>
  </div>

  <% if (!products || products.length === 0) { %>
    <article class="crud-empty">
      <i class="ri-price-tag-3-line"></i>
      <h2>Belum ada produk</h2>
      <p>Tambahkan produk pertama lengkap dengan image dan variant.</p>
      <a href="/admin/products/create" class="crud-btn primary">Create Product</a>
    </article>
  <% } else { %>
    <div class="crud-table-wrap">
      <table class="crud-table product-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach((product) => { %>
            <tr>
              <td data-label="Product">
                <div class="product-cell">
                  <img src="<%= product.image_url %>" alt="<%= product.name %>" />
                  <div>
                    <strong><%= product.name %></strong>
                    <small><%= product.sku %> · <%= product.slug %></small>
                    <% if (Number(product.is_featured) === 1) { %><span class="mini-badge">Featured</span><% } %>
                  </div>
                </div>
              </td>
              <td data-label="Category"><%= product.category_name || '-' %></td>
              <td data-label="Price">
                <strong><%= formatRupiah(product.discount_price || product.price) %></strong>
                <% if (product.discount_price) { %><small class="strike"><%= formatRupiah(product.price) %></small><% } %>
              </td>
              <td data-label="Stock">
                <strong class="<%= Number(product.total_stock) <= 5 ? 'txt-danger' : '' %>"><%= product.total_stock || 0 %></strong>
                <small><%= product.variant_count || 0 %> variants</small>
              </td>
              <td data-label="Status"><span class="status-badge status-<%= product.status %>"><%= product.status %></span></td>
              <td data-label="Actions">
                <div class="table-actions">
                  <a href="/admin/products/<%= product.id %>/edit" class="crud-btn tiny">Edit</a>
                  <form method="POST" action="/admin/products/<%= product.id %>/toggle-status">
                    <button type="submit" class="crud-btn tiny ghost"><%= product.status === 'active' ? 'Deactivate' : 'Activate' %></button>
                  </form>
                  <a href="/shop/<%= product.slug %>" class="crud-btn tiny ghost" target="_blank">View</a>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <nav class="crud-pagination">
      <% for (let page = 1; page <= pagination.totalPages; page += 1) { const pageQs = new URLSearchParams(qsBase); pageQs.set('page', page); %>
        <a href="/admin/products?<%= pageQs.toString() %>" class="<%= page === pagination.page ? 'is-active' : '' %>"><%= page %></a>
      <% } %>
    </nav>
  <% } %>
</section>

<%- include('../partials/shell-end') %>
