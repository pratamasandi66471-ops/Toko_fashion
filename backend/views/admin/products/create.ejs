<%- include('../partials/shell-start', {
  heading: 'Create Product',
  description: 'Buat produk baru dengan minimal satu variant. Upload gambar dilakukan setelah produk dibuat.'
}) %>

<section class="crud-panel form-panel product-form-panel">
  <form method="POST" action="/admin/products" class="crud-form">
    <%- include('./form', { old, categories, formErrors }) %>

    <section class="sub-panel">
      <div class="sub-panel-head">
        <h2>Variants</h2>
        <p>Minimal satu variant. Tambahkan size, color, stock, dan SKU unik.</p>
      </div>
      <div id="variantRepeater">
        <% (variants || [{}]).forEach((variant, index) => { %>
          <%- include('./variant-row', { variant, index, errors: variantErrors[index] || {} }) %>
        <% }); %>
      </div>
      <button type="button" class="crud-btn ghost" id="addVariantRow"><i class="ri-add-line"></i>Add Variant</button>
    </section>

    <div class="form-actions">
      <a href="/admin/products" class="crud-btn ghost">Cancel</a>
      <button type="submit" class="crud-btn primary">Create Product</button>
    </div>
  </form>
</section>

<template id="variantRowTemplate">
  <%- include('./variant-row', { variant: {}, index: '__INDEX__', errors: {} }) %>
</template>

<%- include('../partials/shell-end') %>
