<%- include('_shell-start', {
  heading: 'Security',
  subtitle: 'Jaga akun kamu tetap aman dengan password yang kuat.'
}) %>

<%
const passErrors = passwordErrors || {};
%>

<section class="profile-card profile-narrow-card">
  <div class="profile-card-head">
    <div><span class="profile-card-label">Security</span><h2>Change Password</h2></div>
  </div>
  <form method="POST" action="/profile/password" class="profile-form">
    <label>
      <span>Current Password</span>
      <input class="sf-input" type="password" name="current_password" autocomplete="current-password" required />
      <% if (passErrors.current_password) { %><small class="profile-field-error"><%= passErrors.current_password %></small><% } %>
    </label>
    <label>
      <span>New Password</span>
      <input class="sf-input" type="password" name="new_password" autocomplete="new-password" minlength="8" required />
      <% if (passErrors.new_password) { %><small class="profile-field-error"><%= passErrors.new_password %></small><% } %>
    </label>
    <label>
      <span>Confirm New Password</span>
      <input class="sf-input" type="password" name="confirm_password" autocomplete="new-password" minlength="8" required />
      <% if (passErrors.confirm_password) { %><small class="profile-field-error"><%= passErrors.confirm_password %></small><% } %>
    </label>
    <button type="submit" class="sf-btn sf-btn-primary">Update Password</button>
  </form>
</section>

<%- include('_shell-end') %>
