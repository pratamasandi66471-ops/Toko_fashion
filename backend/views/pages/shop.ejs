<%
const formatRupiah = (value) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(Number(value || 0));
const currentCategory = filters.category || '';
const baseQs = new URLSearchParams();
if (filters.q) baseQs.set('q', filters.q);
if (filters.category) baseQs.set('category', filters.category);
if (filters.sort) baseQs.set('sort', filters.sort);
function stockLabel(stock) {
  const value = Number(stock || 0);
  if (value <= 0) return { text: 'Out of Stock', className: 'out' };
  if (value <= 5) return { text: 'Low Stock', className: 'low' };
  return { text: 'In Stock', className: 'in' };
}
%>

<section class="shop-page">
  <section class="shop-hero" aria-labelledby="shop-hero-title">
    <div class="shop-hero-copy">
      <p class="shop-breadcrumb">Home / Shop</p>
      <h1 id="shop-hero-title">Shop Collection</h1>
      <p class="shop-hero-subtitle">
        Discover timeless essentials, soft colors, and modern pieces made for everyday comfort.
      </p>
      <a href="#shop-products" class="shop-hero-cta">Explore Products</a>
    </div>

    <div class="shop-hero-visual" aria-hidden="true">
      <div class="shop-model-silhouette"><i class="ri-shopping-bag-3-line"></i></div>
      <div class="shop-style-chip chip-top"><i class="ri-shirt-line"></i> Premium Layers</div>
      <div class="shop-style-chip chip-bottom"><i class="ri-sparkling-line"></i> Soft Essentials</div>
    </div>
  </section>

  <nav class="shop-tabs-wrap" aria-label="Category tabs">
    <a href="/shop" class="shop-tab <%= !currentCategory ? 'shop-tab-active' : '' %>">All</a>
    <% categories.forEach((category) => { const qs = new URLSearchParams(baseQs); qs.set('category', category.slug); qs.delete('page'); %>
      <a href="/shop?<%= qs.toString() %>" class="shop-tab <%= currentCategory === category.slug ? 'shop-tab-active' : '' %>"><%= category.name %></a>
    <% }); %>
  </nav>

  <div class="shop-mobile-filter-row">
    <button type="button" class="shop-mobile-filter-btn" id="openShopFilter">
      <i class="ri-equalizer-3-line"></i>
      Filter
    </button>
  </div>

  <section class="shop-content-area" id="shop-products">
    <aside class="shop-filter-panel" id="shopFilterPanel">
      <div class="shop-filter-header">
        <h2>Filter Products</h2>
        <button type="button" id="closeShopFilter" aria-label="Close filter"><i class="ri-close-line"></i></button>
      </div>

      <form method="GET" action="/shop" class="shop-filter-form">
        <label class="shop-filter-search" for="shopFilterSearch">
          <i class="ri-search-line"></i>
          <input id="shopFilterSearch" name="q" type="text" value="<%= filters.q || '' %>" placeholder="Search products..." />
        </label>

        <div class="shop-filter-group">
          <h3>Category</h3>
          <label><input type="radio" name="category" value="" <%= !currentCategory ? 'checked' : '' %> /> All</label>
          <% categories.forEach((category) => { %>
            <label>
              <input type="radio" name="category" value="<%= category.slug %>" <%= currentCategory === category.slug ? 'checked' : '' %> />
              <%= category.name %> (<%= category.product_count || 0 %>)
            </label>
          <% }); %>
        </div>

        <div class="shop-filter-group">
          <h3>Sort</h3>
          <select name="sort" class="shop-filter-select">
            <option value="latest" <%= filters.sort === 'latest' ? 'selected' : '' %>>Latest</option>
            <option value="price_low" <%= filters.sort === 'price_low' ? 'selected' : '' %>>Price: Low to High</option>
            <option value="price_high" <%= filters.sort === 'price_high' ? 'selected' : '' %>>Price: High to Low</option>
            <option value="name" <%= filters.sort === 'name' ? 'selected' : '' %>>Name</option>
          </select>
        </div>

        <div class="shop-filter-actions">
          <button type="submit" class="btn-apply">Apply Filters</button>
          <a href="/shop" class="btn-clear">Clear All</a>
        </div>
      </form>
    </aside>

    <div class="shop-listing-area">
      <div class="shop-listing-toolbar">
        <p>Showing <%= products.length %> of <%= pagination.total %> products</p>
        <form method="GET" action="/shop" class="shop-toolbar-actions">
          <input type="hidden" name="q" value="<%= filters.q || '' %>" />
          <input type="hidden" name="category" value="<%= filters.category || '' %>" />
          <label for="shopSort" class="shop-sort-wrap">
            <span>Sort:</span>
            <select id="shopSort" name="sort" onchange="this.form.submit()">
              <option value="latest" <%= filters.sort === 'latest' ? 'selected' : '' %>>Latest</option>
              <option value="price_low" <%= filters.sort === 'price_low' ? 'selected' : '' %>>Price: Low to High</option>
              <option value="price_high" <%= filters.sort === 'price_high' ? 'selected' : '' %>>Price: High to Low</option>
              <option value="name" <%= filters.sort === 'name' ? 'selected' : '' %>>Name</option>
            </select>
          </label>
        </form>
      </div>

      <% if (!products || products.length === 0) { %>
        <section class="shop-empty-state">
          <h3>No products found</h3>
          <p>Try adjusting your filters or search with another keyword.</p>
          <a href="/shop" id="clearEmptyState">Clear Filters</a>
        </section>
      <% } else { %>
        <div class="shop-product-grid">
          <% products.forEach((product) => { const stock = stockLabel(product.total_stock); %>
            <a href="/shop/<%= product.slug %>" class="shop-product-card" aria-label="View detail <%= product.name %>">
              <% if (product.discount_price) { %><span class="shop-badge badge-sale">Sale</span><% } %>
              <% if (Number(product.is_featured) === 1) { %><span class="shop-badge badge-best">Featured</span><% } %>

              <div class="shop-product-image real-image">
                <img src="<%= product.image_url || '/images/placeholder-product.jpg' %>" alt="<%= product.name %>" />
              </div>

              <div class="shop-product-info">
                <p class="shop-card-category"><%= product.category_name %></p>
                <h3><%= product.name %></h3>
                <p class="shop-price-line">
                  <span class="shop-price"><%= formatRupiah(product.discount_price || product.price) %></span>
                  <% if (product.discount_price) { %><span class="shop-old-price"><%= formatRupiah(product.price) %></span><% } %>
                </p>
                <div class="shop-product-meta">
                  <span class="stock-pill stock-<%= stock.className %>"><%= stock.text %></span>
                </div>
              </div>
            </a>
          <% }); %>
        </div>

        <nav class="shop-pagination" aria-label="Shop pages">
          <% for (let page = 1; page <= pagination.totalPages; page += 1) { const pageQs = new URLSearchParams(baseQs); pageQs.set('page', page); %>
            <a href="/shop?<%= pageQs.toString() %>" class="page-number <%= page === pagination.page ? 'active' : '' %>"><%= page %></a>
          <% } %>
        </nav>
      <% } %>
    </div>
  </section>

  <section class="shop-benefit-bar">
    <article class="shop-benefit-item"><i class="ri-award-line"></i><div><h3>Premium Quality</h3><p>Designed with precise tailoring and refined finishing.</p></div></article>
    <article class="shop-benefit-item"><i class="ri-leaf-line"></i><div><h3>Comfortable Materials</h3><p>Soft and breathable fabrics for all-day wear.</p></div></article>
    <article class="shop-benefit-item"><i class="ri-truck-line"></i><div><h3>Fast Delivery</h3><p>Quick shipping with careful packaging every order.</p></div></article>
    <article class="shop-benefit-item"><i class="ri-refresh-line"></i><div><h3>Easy Returns</h3><p>Simple return process with flexible exchange support.</p></div></article>
  </section>
</section>

<script src="/js/shop.js"></script>
