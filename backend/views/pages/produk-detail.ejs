<%
const formatRupiah = (value) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(Number(value || 0));
const gallery = images && images.length ? images : [{ image_url: '/images/placeholder-product.jpg', is_primary: 1 }];
const primaryImage = gallery[0];
const totalStock = (variants || []).reduce((sum, item) => sum + Number(item.stock || 0), 0);
%>

<script type="application/json" id="variantData"><%- JSON.stringify(variants || []).replace(/</g, '\\u003c') %></script>

<section class="product-detail-page">
  <div class="breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/shop">Shop</a>
    <span>/</span>
    <a href="/shop?category=<%= product.category_slug %>"><%= product.category_name %></a>
    <span>/</span>
    <p><%= product.name %></p>
  </div>

  <section class="product-main db-product-main">
    <div class="product-gallery">
      <div class="thumbnail-list">
        <% gallery.forEach((image, index) => { %>
          <button type="button" class="thumb <%= index === 0 ? 'active' : '' %>" data-image="<%= image.image_url %>">
            <img src="<%= image.image_url %>" alt="<%= product.name %> image <%= index + 1 %>" />
          </button>
        <% }); %>
      </div>

      <div class="main-image-box">
        <img id="mainProductImage" src="<%= primaryImage.image_url %>" alt="<%= product.name %>" />
      </div>
    </div>

    <div class="product-info-panel">
      <div class="product-badges">
        <% if (Number(product.is_featured) === 1) { %><span>Featured</span><% } %>
        <% if (product.discount_price) { %><span class="blue">Sale</span><% } %>
      </div>

      <h1><%= product.name %></h1>
      <p class="product-sku">SKU: <%= product.sku %></p>

      <h2 class="product-price">
        <%= formatRupiah(product.discount_price || product.price) %>
        <% if (product.discount_price) { %><span><%= formatRupiah(product.price) %></span><% } %>
      </h2>

      <p class="product-short-desc"><%= product.description || 'Premium S Fashion product with a clean, timeless silhouette.' %></p>
      <p class="stock-summary <%= totalStock <= 0 ? 'is-out' : totalStock <= 5 ? 'is-low' : 'is-in' %>">
        <%= totalStock <= 0 ? 'Out of Stock' : totalStock <= 5 ? `Low Stock - ${totalStock} left` : `In Stock - ${totalStock} available` %>
      </p>

      <div class="product-divider"></div>

      <div class="option-group">
        <div class="option-label"><strong>Color:</strong> <span id="selectedColor">Choose color</span></div>
        <div class="color-options">
          <% [...new Map((variants || []).map((variant) => [variant.color, variant])).values()].forEach((variant) => { %>
            <button type="button" class="color-dot" data-color="<%= variant.color %>" style="--dot-color: <%= variant.color_code || '#F4E1E1' %>;" aria-label="<%= variant.color %>"></button>
          <% }); %>
        </div>
      </div>

      <div class="option-group">
        <div class="size-label-row">
          <div class="option-label"><strong>Size:</strong> <span id="selectedSize">Choose size</span></div>
        </div>
        <div class="size-options">
          <% [...new Set((variants || []).map((variant) => variant.size))].forEach((size) => { %>
            <button type="button" data-size="<%= size %>"><%= size %></button>
          <% }); %>
        </div>
      </div>

      <div class="option-group">
        <div class="option-label"><strong>Variant Stock:</strong> <span id="variantStockText">Select a variant first</span></div>
        <div class="quantity-box">
          <button type="button" id="qtyMinus"><i class="ri-subtract-line"></i></button>
          <input type="number" id="quantityInput" value="1" min="1" max="1" readonly />
          <button type="button" id="qtyPlus"><i class="ri-add-line"></i></button>
        </div>
      </div>

      <form action="/cart/add" method="POST" class="product-actions">
        <input type="hidden" name="product_variant_id" id="variantIdInput" value="" />
        <input type="hidden" name="quantity" id="quantityHiddenInput" value="1" />
        <button type="submit" class="btn-add-cart" id="addToCartButton" disabled>
          <i class="ri-shopping-bag-line"></i>
          Add to Cart
        </button>
      </form>

      <% if (!variants || variants.length === 0) { %>
        <p class="detail-warning">Produk ini belum memiliki variant aktif.</p>
      <% } %>
    </div>

    <div class="shipping-card">
      <div class="shipping-item"><i class="ri-truck-line"></i><div><h4>Fast Shipping</h4><p>Careful packaging for every order.</p></div></div>
      <div class="shipping-item"><i class="ri-shield-check-line"></i><div><h4>Secure Checkout</h4><p>Cart and checkout use selected variant stock.</p></div></div>
      <div class="shipping-item"><i class="ri-loop-left-line"></i><div><h4>Easy Returns</h4><p>Simple exchange support for eligible items.</p></div></div>
    </div>
  </section>

  <section class="product-extra">
    <div class="detail-card description-card">
      <div class="tabs"><button class="active">Description</button></div>
      <div class="tab-content">
        <p><%= product.description || 'A refined S Fashion piece designed for daily confidence and clean styling.' %></p>
      </div>
    </div>
  </section>

  <section class="related-products">
    <div class="related-header">
      <h2>You May Also Love</h2>
      <a href="/shop">View all <i class="ri-arrow-right-line"></i></a>
    </div>

    <% if (relatedProducts && relatedProducts.length > 0) { %>
      <div class="related-grid">
        <% relatedProducts.forEach((item) => { %>
          <a href="/shop/<%= item.slug %>" class="related-card" aria-label="View detail <%= item.name %>">
            <div>
              <h3><%= item.name %></h3>
              <p><%= formatRupiah(item.discount_price || item.price) %></p>
            </div>
            <img src="<%= item.image_url || '/images/placeholder-product.jpg' %>" alt="<%= item.name %>" />
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <p class="muted-related">Belum ada rekomendasi produk terkait.</p>
    <% } %>
  </section>
</section>

<script src="/js/product-detail.js"></script>
